{
  // Local development: your own Windows sign-in against your local BC_Phc, and emails written
  // to a folder as .eml files instead of being sent. Use the same server name as the internal
  // PHC API's appsettings.Development.json.
  "ConnectionStrings": {
    "Phc": "Server=(localdb)\\MSSQLLocalDB;Database=BC_Phc;Integrated Security=true;TrustServerCertificate=true"
  },
  "Email": {
    "FromAddress": "phc-noreply@localhost.test",
    "PickupDirectory": "C:\\temp\\phc-mail"
  }
}
