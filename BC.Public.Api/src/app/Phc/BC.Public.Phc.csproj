<!-- The public PHC API: the application form's choices and the endpoint that accepts applications. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

	<!-- Writes this API's OpenAPI description into the public frontend project on every build,
	     where the form generates its TypeScript types from it. -->
	<PropertyGroup>
		<OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
		<OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../../BC.Public.Web/openapi</OpenApiDocumentsDirectory>
		<OpenApiGenerateDocumentsOptions>--file-name phc</OpenApiGenerateDocumentsOptions>
	</PropertyGroup>

	<ItemGroup>
		<!-- The API description -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- PHC's database. No Tools package: this app never has migrations. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

</Project>
