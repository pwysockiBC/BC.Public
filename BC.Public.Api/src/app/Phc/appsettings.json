{
  // Settings shared by every environment. Server-specific values (connection string, sender
  // address, Data Protection keys folder) go in appsettings.Production.json on the server only.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Phc": {
    // Must match the version of the agreements text the form shows.
    "AgreementsVersion": "2027-1"
  },

  "Spam": {
    "MinimumFillSeconds": 3,
    "FormTokenLifetimeHours": 24,
    "SubmitPermitLimit": 10,
    "SubmitWindowMinutes": 10,
    "FormPermitPerMinute": 60
  },

  "Email": {
    "Host": "10.250.0.52",
    "Port": 25,
    "EnableSsl": false,
    "FromAddress": "",
    "FromName": "Bergen County Project Homeless Connect",
    "ReplyTo": "",
    "TimeoutSeconds": 15
  }
}
