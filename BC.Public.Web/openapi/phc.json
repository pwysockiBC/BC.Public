{
  "openapi": "3.1.1",
  "info": {
    "title": "BC.Public.Phc | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/form": {
      "get": {
        "tags": [
          "Form"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/FormResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormResponse"
                }
              }
            }
          }
        }
      }
    },
    "/applications": {
      "post": {
        "tags": [
          "Applications"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitApplicationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitApplicationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitApplicationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitApplicationResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitApplicationResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitApplicationResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FormOption": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "FormProject": {
        "required": [
          "id",
          "name",
          "eventDate",
          "registrationClosesAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "eventDate": {
            "type": "string",
            "format": "date"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FormRegion": {
        "required": [
          "id",
          "name",
          "locations"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "FormResponse": {
        "required": [
          "isOpen",
          "project",
          "nextOpensAt",
          "streetTeamRegions",
          "spokenLanguages",
          "formToken"
        ],
        "type": "object",
        "properties": {
          "isOpen": {
            "type": "boolean"
          },
          "project": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/FormProject"
              }
            ]
          },
          "nextOpensAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "streetTeamRegions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormRegion"
            }
          },
          "spokenLanguages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormOption"
            }
          },
          "formToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ParticipationRequest": {
        "type": "object",
        "properties": {
          "pitSurvey": {
            "type": "boolean"
          },
          "streetTeam": {
            "type": "boolean"
          },
          "eventAssist": {
            "type": "boolean"
          },
          "reportLocations": {
            "type": "boolean"
          },
          "shareFlyer": {
            "type": "boolean"
          },
          "donate": {
            "type": "boolean"
          },
          "resourceTable": {
            "type": "boolean"
          },
          "distributionInfo": {
            "type": "boolean"
          },
          "directService": {
            "type": "boolean"
          },
          "shiftMorning": {
            "type": "boolean"
          },
          "shiftMidday": {
            "type": "boolean"
          },
          "donationDetails": {
            "maxLength": 2000,
            "type": [
              "null",
              "string"
            ]
          },
          "resourceTableSummary": {
            "maxLength": 2000,
            "type": [
              "null",
              "string"
            ]
          },
          "directServiceDetails": {
            "maxLength": 2000,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SubmitApplicationRequest": {
        "required": [
          "firstName",
          "lastName",
          "addressLine",
          "city",
          "state",
          "zipCode",
          "phone",
          "email",
          "participation",
          "agreementsVersion"
        ],
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer",
            "format": "int32"
          },
          "formToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "homepage": {
            "type": [
              "null",
              "string"
            ]
          },
          "firstName": {
            "maxLength": 100,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "type": "string"
          },
          "isUnder18": {
            "type": "boolean"
          },
          "dateOfBirth": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "addressLine": {
            "maxLength": 200,
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "type": "string"
          },
          "state": {
            "maxLength": 50,
            "type": "string"
          },
          "zipCode": {
            "maxLength": 10,
            "type": "string"
          },
          "phone": {
            "maxLength": 30,
            "type": "string"
          },
          "email": {
            "maxLength": 256,
            "type": "string"
          },
          "affiliationName": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          },
          "affiliationAddressLine": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          },
          "affiliationCity": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ]
          },
          "affiliationState": {
            "maxLength": 50,
            "type": [
              "null",
              "string"
            ]
          },
          "affiliationZipCode": {
            "maxLength": 10,
            "type": [
              "null",
              "string"
            ]
          },
          "affiliationPhone": {
            "maxLength": 30,
            "type": [
              "null",
              "string"
            ]
          },
          "affiliationPhoneExt": {
            "maxLength": 10,
            "type": [
              "null",
              "string"
            ]
          },
          "affiliationEmail": {
            "maxLength": 256,
            "type": [
              "null",
              "string"
            ]
          },
          "participation": {
            "$ref": "#/components/schemas/ParticipationRequest"
          },
          "streetTeamRegionIds": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "spokenLanguageIds": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "agreementsAccepted": {
            "type": "boolean"
          },
          "agreementsVersion": {
            "maxLength": 20,
            "type": "string"
          }
        }
      },
      "SubmitApplicationResult": {
        "required": [
          "referenceNumber",
          "confirmationEmailSent"
        ],
        "type": "object",
        "properties": {
          "referenceNumber": {
            "type": "string"
          },
          "confirmationEmailSent": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Form"
    },
    {
      "name": "Applications"
    }
  ]
}